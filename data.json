{
  "presets": {
    "tareas_de_hoy": "# Tareas con fecha de hoy (o ya pasadas) PENDIENTES\nnot done\n(due today) OR (scheduled today) OR (due before today) OR (scheduled before today)\ngroup by priority",
    "tareas_de_esta_nota": "# Tareas definidas en esta nota PENDIENTES\nnot done \npath includes {{query.file.path}}",
    "tareas_de_esta_nota_todas": "# Tareas definidas en esta nota\npath includes {{query.file.path}}"
  },
  "uiLanguage": "es",
  "prioritySymbols": {
    "highest": "💣",
    "high": "🌟",
    "medium": "🔴",
    "normal": "🟡",
    "low": "🟢",
    "lowest": "⚪",
    "nextMonth": "🟣"
  },
  "globalQuery": "((tags include #task) OR (tags include #question) OR (tags include #conversación) OR (tags include #email) OR (tags include #conclusión)) OR (path includes Notas/Hogar/Despensa)\nsort by function \\\n    const orden = {0: 0, 1: 1, 2: 2, 7: 3, 4: 4, 6: 5, 5: 6, 3: 7}; \\\n    return orden[task.priorityNumber] ?? 99;\nsort by done\nsort by due\nsort by scheduled\nshow tree\nhide backlinks\nhide toolbar\nhide task count",
  "globalFilter": "",
  "removeGlobalFilter": true,
  "taskFormat": "dataview",
  "setCreatedDate": false,
  "setDoneDate": true,
  "setCancelledDate": false,
  "autoSuggestInEditor": true,
  "autoSuggestMinMatch": 0,
  "autoSuggestMaxItems": 6,
  "provideAccessKeys": true,
  "useFilenameAsScheduledDate": false,
  "filenameAsScheduledDateFormat": "YYYY-MM-DD",
  "filenameAsDateFolders": [],
  "recurrenceOnNextLine": false,
  "removeScheduledDateOnRecurrence": false,
  "searchResults": {
    "taskCountLocation": "bottom"
  },
  "statusSettings": {
    "coreStatuses": [
      {
        "symbol": " ",
        "name": "Todo",
        "nextStatusSymbol": "/",
        "availableAsCommand": true,
        "type": "TODO"
      },
      {
        "symbol": "x",
        "name": "Done",
        "nextStatusSymbol": "-",
        "availableAsCommand": true,
        "type": "DONE"
      }
    ],
    "customStatuses": [
      {
        "symbol": " ",
        "name": "TODO",
        "nextStatusSymbol": "/",
        "availableAsCommand": false,
        "type": "TODO"
      },
      {
        "symbol": "/",
        "name": "In Progress",
        "nextStatusSymbol": "p",
        "availableAsCommand": false,
        "type": "IN_PROGRESS"
      },
      {
        "symbol": "p",
        "name": "OK",
        "nextStatusSymbol": "c",
        "availableAsCommand": false,
        "type": "DONE"
      },
      {
        "symbol": "c",
        "name": "KO",
        "nextStatusSymbol": "x",
        "availableAsCommand": false,
        "type": "DONE"
      },
      {
        "symbol": "x",
        "name": "Done",
        "nextStatusSymbol": "-",
        "availableAsCommand": false,
        "type": "DONE"
      },
      {
        "symbol": "-",
        "name": "Cancelled",
        "nextStatusSymbol": "d",
        "availableAsCommand": false,
        "type": "CANCELLED"
      },
      {
        "symbol": "d",
        "name": "Discarded",
        "nextStatusSymbol": ">",
        "availableAsCommand": false,
        "type": "CANCELLED"
      },
      {
        "symbol": ">",
        "name": "Delegated",
        "nextStatusSymbol": " ",
        "availableAsCommand": false,
        "type": "TODO"
      }
    ]
  },
  "isShownInEditModal": {
    "priority": true,
    "recurrence": true,
    "due": true,
    "scheduled": true,
    "start": true,
    "before_this": false,
    "after_this": false,
    "status": true,
    "created": false,
    "done": true,
    "cancelled": false
  },
  "dismissedNotices": {
    "live-preview-callout-warning": false
  },
  "features": {
    "INTERNAL_TESTING_ENABLED_BY_DEFAULT": true
  },
  "generalSettings": {},
  "headingOpened": {
    "Core Statuses": true,
    "Custom Statuses": true
  },
  "debugSettings": {
    "ignoreSortInstructions": false,
    "showTaskHiddenData": false,
    "recordTimings": false
  },
  "loggingOptions": {
    "minLevels": {
      "": "info",
      "tasks": "info",
      "tasks.Cache": "info",
      "tasks.Events": "info",
      "tasks.File": "info",
      "tasks.Query": "info",
      "tasks.Task": "info"
    }
  }
}